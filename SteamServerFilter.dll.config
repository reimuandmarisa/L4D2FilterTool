<?xml version="1.0" encoding="utf-8" ?>
<configuration>
  <configSections>
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler, log4net"/>
  </configSections>

  <log4net>
    <appender name="RollingFileAppender" type="log4net.Appender.RollingFileAppender">
      <param name="File" value="Logs\"/>
      <param name="AppendToFile" value="true"/>
      <param name="MaxSizeRollBackups" value="10"/>
      <param name="StaticLogFileName" value="false"/>
      <param name="DatePattern" value="yyyy-MM-dd'.log'"/>
      <param name="RollingStyle" value="Date"/>
      <layout type="log4net.Layout.PatternLayout">
        <param name="ConversionPattern" value="%date{yyyy-MM-dd HH:mm:ss.fff} %-5p %m%n" />
      </layout>
    </appender>

    <!-- V-18: 原来这里有 <appender-ref ref="ColoredConsoleAppender"/>，引用了一个
         未定义的 appender（log4net 内部会静默报错）。已移除。

         level 保持 all/DEBUG 是【有意为之】：FilterTool 的「服务器 IP 候选」证据、
         今日拦截计数都依赖 "Block incoming traffic from an endpoint in black list"
         这类 DEBUG 行。如果你不需要这些证据、只想要小体积日志，
         可以把下面改成 <level value="INFO" />（日志会小一个数量级，但 IP 候选会变空）。
         注意 RollingStyle=Date 时 log4net 不会自动删旧文件，历史日志需要手工清理。 -->
    <root>
      <level value="all" />
      <appender-ref ref="RollingFileAppender"/>
    </root>
  </log4net>
</configuration>
