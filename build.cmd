@echo off
rem ===========================================================================
rem  build.cmd --- SteamServerFilter / FilterTool build gate  (optimization 0.2)
rem  The file list below is the single source of truth (used to live in a stale comment).
rem  Gates: --layout (UI layout) and --doc-check (docs sync).
rem  NOTE: paths contain "(x86)", so no parenthesised if-blocks are used.
rem ===========================================================================
setlocal
cd /d "%~dp0"

set "CSC=C:\Program Files\Microsoft Visual Studio\2022\Community\MSBuild\Current\Bin\Roslyn\csc.exe"
if not exist "%CSC%" set "CSC=C:\Program Files\Microsoft Visual Studio\2022\Enterprise\MSBuild\Current\Bin\Roslyn\csc.exe"
if not exist "%CSC%" set "CSC=C:\Program Files\Microsoft Visual Studio\2022\Professional\MSBuild\Current\Bin\Roslyn\csc.exe"
if not exist "%CSC%" set "VSWHERE=%ProgramFiles(x86)%\Microsoft Visual Studio\Installer\vswhere.exe"
if not exist "%CSC%" if exist "%VSWHERE%" for /f "usebackq delims=" %%i in (`"%VSWHERE%" -latest -products * -requires Microsoft.VisualStudio.Component.Roslyn.Compiler -property installationPath`) do set "CSC=%%i\MSBuild\Current\Bin\Roslyn\csc.exe"
if not exist "%CSC%" set "CSC=csc.exe"
set "REF=C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.7.2"
if not exist "%REF%\mscorlib.dll" set "REF=C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.8"
if not exist "%REF%\mscorlib.dll" set "REF=C:\Program Files (x86)\Reference Assemblies\Microsoft\Framework\.NETFramework\v4.6.1"

if not exist "%REF%\mscorlib.dll" goto noref
if not exist "_build\IpBlock.cs" goto nosrc

tasklist /fi "imagename eq FilterTool.exe" 2>nul | "%SystemRoot%\System32\find.exe" /i "FilterTool.exe" >nul
if not errorlevel 1 goto stopfirst
goto stamp

:stopfirst
echo [WARN] FilterTool.exe is running - stopping it first (interception pauses).
schtasks /End /TN "SteamServerFilter IP Block" >nul 2>&1
taskkill /IM FilterTool.exe /F >nul 2>&1
ping -n 4 127.0.0.1 >nul

:stamp
set "STAMP=unknown"
for /f "delims=" %%i in ('powershell -NoProfile -Command Get-Date -Format s') do set "STAMP=%%i"
> _build\BuildStamp.cs echo // generated by build.cmd -- do not edit
>>_build\BuildStamp.cs echo namespace SteamServerFilterIpBlock
>>_build\BuildStamp.cs echo {
>>_build\BuildStamp.cs echo     internal static class BuildStamp
>>_build\BuildStamp.cs echo     {
>>_build\BuildStamp.cs echo         public const string Time = "%STAMP%";
>>_build\BuildStamp.cs echo     }
>>_build\BuildStamp.cs echo }

rem --- 组服过滤：把已经过实机验证的原生 DLL 作为嵌入资源合并进 FilterTool.exe ---
if not exist "_build\groupfilter" mkdir "_build\groupfilter"
if exist "_work\gf2\dist\SSF_GroupFilter2.dll" goto :native_ready
rem git 仓库不提交生成物：新克隆的工作区先从这里按源码构建原生 DLL（需要 VS x86 工具链）。
echo [native] _work\gf2\dist\SSF_GroupFilter2.dll not found - building from source ...
call "_work\gf2\build.cmd"
if errorlevel 1 goto nodll
:native_ready
if not exist "_work\gf2\dist\SSF_GroupFilter2.dll" goto nodll
copy /Y "_work\gf2\dist\SSF_GroupFilter2.dll" "_build\groupfilter\SSF_GroupFilter2.dll" >nul
if errorlevel 1 goto nodll

echo [1/4] compiling ...
"%CSC%" -nologo -t:winexe -platform:x86 -optimize+ -langversion:latest ^
  -out:FilterTool.exe -win32manifest:_build\IpBlock.manifest ^
  -win32icon:_build\FilterTool.ico -resource:_build\FilterTool.ico,FilterTool.ico ^
  -resource:_build\groupfilter\SSF_GroupFilter2.dll,GroupFilterDll ^
  -r:"%REF%\mscorlib.dll" -r:"%REF%\System.dll" -r:"%REF%\System.Core.dll" ^
  -r:"%REF%\System.Drawing.dll" -r:"%REF%\System.Windows.Forms.dll" ^
  _build\SafeFile.cs _build\Config.cs _build\BuildStamp.cs _build\RulesAdd.cs _build\IpBlock.cs ^
  _build\NameLayer.cs _build\TrayHost.cs _build\AppIcon.cs _build\CapLocate.cs ^
  _build\GroupListDiagnostics.cs _build\GroupServerFilter.cs _build\SelfTest.cs _build\Lifecycle.cs _build\Unified.cs _build\FilterTool.cs
if errorlevel 1 goto failed

echo [2/4] layout self-check ...
FilterTool.exe --layout
if errorlevel 1 goto failed

echo [3/4] invariant self-test ...
FilterTool.exe --selftest
if errorlevel 1 goto failed

echo [4/4] doc sync self-check ...
FilterTool.exe --doc-check
if errorlevel 1 (echo [FAILED] docs out of sync - doc-check is a hard gate & goto failed)

echo [OK] FilterTool.exe rebuilt  (build stamp %STAMP%)
if "%SSF_NO_RESIDENT%"=="1" goto :noresident
schtasks /Run /TN "SteamServerFilter IP Block" >nul 2>&1
echo [OK] resident blocker restarted
goto :buildsuccess

:noresident
echo [OK] resident blocker restart skipped (SSF_NO_RESIDENT=1)

:buildsuccess
endlocal
exit /b 0

:noref
echo [FAILED] .NET Framework 4.7.2 reference assemblies not found:
echo          %REF%
endlocal
exit /b 1

:nosrc
echo [FAILED] _build\IpBlock.cs not found - run build.cmd from the project root.
endlocal
exit /b 1

:nodll
echo [FAILED] _work\gf2\dist\SSF_GroupFilter2.dll not found (or copy failed).
echo          组服过滤这条链路需要原生 DLL：已在上面尝试 _work\gf2\build.cmd。
echo          若失败，请确认已安装 Visual Studio C++ x86 工具链，然后手工运行：
echo            cd /d "%~dp0_work\gf2" ^&^& build.cmd
endlocal
exit /b 1

:failed
echo [FAILED] see the messages above.
endlocal
exit /b 1
